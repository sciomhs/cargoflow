{
  "expo": {
    "name": "CargoFlow",
    "slug": "cargoflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cargoflow",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F2EE",
          "dark": {
            "backgroundColor": "#141311"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "CargoFlow прикрепляет фото груза и документов к рейсу.",
          "cameraPermission": "CargoFlow снимает груз и документы на этапах рейса."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
